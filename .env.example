CDS_EMAIL=
CDS_TOKEN=
CONTACT=
# UN Comtrade (M10): utan nyckel används den rate-limiteda preview-endpointen
# (4 s paus mellan anrop). Gratisnyckel: comtradeplus.un.org → fullt data-API
# (~500 anrop/dag). Uppdateras aldrig i frontend.
COMTRADE_API_KEY=
ENTSO_E_TOKEN=
FINGRID_DATASETS=
FINGRID_KEY=
NVD_API_KEY=
OSV_WATCH_PACKAGES=
NVE_API_KEY=
SVK_AFRR_CAPACITY_RESOURCE_ID=
SVK_API_BASE_URL=
SVK_DAY_AHEAD_PRICES_RESOURCE_ID=
SVK_FCR_ACTIVATED_ENERGY_RESOURCE_ID=
SVK_FCR_AGGREGATED_VOLUMES_RESOURCE_ID=
SVK_FCR_BID_VOLUMES_RESOURCE_ID=
SVK_FCR_CAPACITY_RESOURCE_ID=
SVK_MFRR_CAPACITY_RESOURCE_ID=
SVK_PHYSICAL_FLOWS_RESOURCE_ID=
TRAFIKVERKET_KEY=
# Persistent collector snapshot (local VM/container with durable disk)
NORTHWATCH_STORE_FILE=server/data/store.json

# Custom SMHI map-click point protection
SMHI_ADHOC_CACHE_MAX=500
SMHI_ADHOC_RATE_LIMIT_PER_MIN=20

# NVD request pacing/retry policy (shared queue per backend process)
NVD_RETRY_MAX=4

# Persistence backend: local (default) or firestore
STORE_DRIVER=local
# Set STORE_DRIVER=firestore for Google Cloud Run / AI Studio deployment
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION=northwatch_sources
# Optional: require Firestore restore to succeed before backend starts
STORE_REQUIRED=false
# Optional for local emulator development
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIRESTORE_PROJECT_ID is not required; use GOOGLE_CLOUD_PROJECT above
