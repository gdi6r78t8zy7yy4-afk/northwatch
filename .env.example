# Northwatch – backend-kredensials. Finns ALDRIG i frontend eller i git.
# Kopiera till .env och fyll i.

# Identifiera klienten i User-Agent (MET Norway kräver kontaktuppgift).
CONTACT=Er Namn – Northwatch (contact: ni@example.org)

# Servrport (standard 3000)
#PORT=3000

# --- API-nycklar (källor utan nyckel visas "Saknar ..." i källhälsan) ---

# Fingrid Open Data (gratis, https://data.fingrid.fi/en/instructions)
FINGRID_KEY=
# Konkreta dataset: "datasetId:Indikatornamn,datasetId2:..."
FINGRID_DATASETS=

# Svenska kraftnät Data Service – resource_id per dataset
SVK_RESOURCE_ID=

# Trafikverket öppna API (konto + licens)
TRAFIKVERKET_KEY=

# ENTSO-E Transparency Platform security token (gratis; begär via
# transparency@entsoe.eu med ämnet "Restful API access", generera sedan token
# under My Account Settings).
ENTSO_E_TOKEN=

# NIST NVD / FIRST EPSS – valfri, högre rate-limit
NVD_API_KEY=

# NVE HydAPI (gratis registrering, https://hydapi.nve.no) – vattenstånd, NO.
# Header X-API-Key. Utan nyckel visas källan "Saknar NVE_API_KEY".
NVE_API_KEY=
# Valfritt: fast stationslista ("6.10.0,7.10.0,..."), annars hämtas de
# NVE_STATION_LIMIT första aktiva stationerna från API:t.
#NVE_STATIONS=
#NVE_STATION_LIMIT=5
# Parameter som namn eller id (standard "vannstand" = vattenstånd, m)
#NVE_PARAMETER=vannstand

# Copernicus Climate Data Store (gratis personal access token,
# https://cds.climate.copernicus.eu/profile) – ERA5 reanalys (Nordisk).
# Både token och kontots e-post krävs per anrop.
CDS_TOKEN=
CDS_EMAIL=ni@example.org

# --- Endpointöverstyrningar (endast vid felsökning; standarderna är verifierade) ---

# SMHI vädervarningar – sätt bekräftad endpoint när den hittats
#SMHI_WARNINGS_URL=https://opendata-download-warnings.smhi.se/ibww/api/version/1/warnings/all.json

# Digitraffic vägtrafikmeddelanden – v1/messages verifierad 2026-11-01
#DIGITRAFFIC_MESSAGES_URL=https://tie.digitraffic.fi/api/traffic-message/v1/messages?inactiveHours=0&includeAreaGeometry=false

# ENTSO-E bas-URL (standard https://web-api.tp.entsoe.eu/api)
#ENTSO_E_BASE=https://web-api.tp.entsoe.eu/api

# Statnett flödesendpoint (standard fungerar)
#STATNETT_FLOW_URL=https://driftsdata.statnett.no/restapi/PhysicalFlowMap/GetFlow

# MET Norway – plats att följa (standard Oslo)
#METNO_LAT=59.91
#METNO_LON=10.75
#METNO_CITY=Oslo

# DMI (DK) observationsstation (standard 06180 = Köbenhavns Lufthavn)
#DMI_STATION_ID=06180

# OSM/Overpass (M3) – publik instans är ofta fullbelagd; spegel finns t.ex.
# https://overpass.kumi.systems/api/interpreter (samma frågespråk)
#OVERPASS_URL=https://overpass-api.de/api/interpreter
